{
  "dirs": [
    "/path/to/project-a",
    "/path/to/project-b"
  ],
  "tools": [
    {
      "name": "opencode",
      "cmd": "opencode"
    },
    {
      "name": "omp（Oh My Pi）",
      "cmd": "omp",
      "args": [
        "--model",
        "mistral/deepseek-v4-1-flash-1017:max"
      ],
      "env": {
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890"
      }
    }
  ],
  "pathPrepend": [
    "~/.bun/bin",
    "/opt/homebrew/bin",
    "/usr/local/bin"
  ],
  "copy": {
    "defaultFlags": []
  }
}
